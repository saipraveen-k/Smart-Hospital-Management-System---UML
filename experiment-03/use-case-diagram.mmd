flowchart LR
    %% Note: Because Mermaid.js does not provide a native UML Use Case Diagram syntax, 
    %% the use-case model is represented using Mermaid flowchart notation while 
    %% preserving UML actor, system-boundary, include, extend, and generalization semantics.

    subgraph SystemBoundary ["Smart Hospital Management System (SHMS)"]
        %% Patient Use Cases
        UC1(["Register Patient"])
        UC2(["Update Profile"])
        UC3(["Book Appointment"])
        UC6(["View Medical Reports"])
        UC8(["Pay Bill Online"])

        %% Book Appointment Includes
        UC3a(["Select Department"])
        UC3b(["Select Doctor"])
        UC3c(["Check Doctor Availability"])
        UC3d(["Generate Appointment"])

        %% Receptionist Use Cases
        UC14(["OP Check-In"])
        UC16(["Create Admission"])
        UC17(["Allocate Bed"])
        UC18(["Discharge Patient"])

        %% Doctor Use Cases
        UC19(["View Patient Record"])
        UC20(["Doctor Consultation"])
        UC21(["Record Diagnosis"])
        UC22(["Create Prescription"])
        UC23(["Request Laboratory Test"])
        UC25(["Recommend Inpatient Admission"])
        UC27(["Prepare Discharge Summary"])

        %% Lab Tech Use Cases
        UC28(["Receive Lab Test Request"])
        UC29(["Collect Specimen Sample"])
        UC30(["Process Laboratory Test"])
        UC31(["Enter Result & Upload Report"])

        %% Pharmacist Use Cases
        UC32(["Dispense Medicine"])
        UC32a(["Low Stock Alert"])

        %% Cashier Use Cases
        UC33(["Billing and Payment"])
        UC33a(["Calculate Charges"])
        UC33b(["Process Payment"])
        UC33c(["Generate Receipt"])

        %% Admin Use Cases
        UC34(["Manage Users & Roles"])
        UC35(["View Security Audit Logs"])
    end

    %% Primary Actors
    Patient["Patient (Primary)"]
    Receptionist["Receptionist (Primary)"]
    Doctor["Doctor (Primary)"]
    LabTech["Lab Technician (Primary)"]
    Pharmacist["Pharmacist (Primary)"]
    Cashier["Cashier (Primary)"]

    %% Supporting / Managerial Actor
    Admin["Admin (Supporting/Managerial)"]

    %% Actor Connections
    Patient --> UC1
    Patient --> UC2
    Patient --> UC3
    Patient --> UC6
    Patient --> UC8

    Receptionist --> UC1
    Receptionist --> UC14
    Receptionist --> UC16
    Receptionist --> UC17
    Receptionist --> UC18

    Doctor --> UC19
    Doctor --> UC20
    Doctor --> UC25
    Doctor --> UC27

    LabTech --> UC28
    LabTech --> UC29
    LabTech --> UC30
    LabTech --> UC31

    Pharmacist --> UC32

    Cashier --> UC33

    Admin --> UC34
    Admin --> UC35

    %% Include Relationships (Dashed)
    UC3 -.->|"<<include>>"| UC3a
    UC3 -.->|"<<include>>"| UC3b
    UC3 -.->|"<<include>>"| UC3c
    UC3 -.->|"<<include>>"| UC3d

    UC20 -.->|"<<include>>"| UC19
    UC20 -.->|"<<include>>"| UC21
    UC20 -.->|"<<include>>"| UC22

    UC33 -.->|"<<include>>"| UC33a
    UC33 -.->|"<<include>>"| UC33b
    UC33 -.->|"<<include>>"| UC33c

    %% Extend Relationships (Dashed)
    UC23 -.->|"<<extend>>"| UC20
    UC25 -.->|"<<extend>>"| UC20
    UC32a -.->|"<<extend>>"| UC32
