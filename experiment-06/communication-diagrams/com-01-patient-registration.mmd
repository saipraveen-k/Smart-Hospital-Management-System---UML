    %% UML Communication Diagram — Mermaid Representation
    %% Scenario: Patient Registration (EXP6-COM-01)

    Actor[":Receptionist"]
    UI[":PatientRegistrationUI"]
    Ctrl[":PatientRegistrationController"]
    Repo[":PatientRepository"]
    Entity[":Patient"]

    Actor -- "1: submitRegistrationDetails(dto)" --> UI
    UI -- "1.1: registerPatient(dto)" --> Ctrl
    Ctrl -- "1.2: validateFields(dto)" --> Ctrl
    Ctrl -- "1.3: findByPhone(phone)" --> Repo
    Ctrl -- "1.4: generateUHID()" --> Ctrl
    Ctrl -- "1.5: create(dto, UHID)" --> Entity
    Ctrl -- "1.6: save(patientObj)" --> Repo
    Ctrl -- "1.7: confirmRegistration(UHID)" --> UI
    UI -- "1.8: renderUHIDCard()" --> Actor
