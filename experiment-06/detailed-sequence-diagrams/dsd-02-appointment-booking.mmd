sequenceDiagram
    autonumber
    actor Patient as Patient
    participant UI as AppointmentUI
    participant Ctrl as AppointmentController
    participant DocEntity as Doctor
    participant ApptEntity as Appointment

    Patient->>UI: selectDoctorAndDate(doctorId, date)
    activate UI
    UI->>Ctrl: getAvailableSlots(doctorId, date)
    activate Ctrl
    Ctrl->>DocEntity: getSchedule(date)
    activate DocEntity
    DocEntity-->>Ctrl: doctorSchedule
    deactivate DocEntity
    Ctrl-->>UI: return AvailableSlotsList
    deactivate Ctrl
    UI-->>Patient: displaySlotsGrid()

    Patient->>UI: submitBooking(patientId, doctorId, slotTime)
    UI->>Ctrl: bookAppointment(patientId, doctorId, slotTime)
    activate Ctrl
    Ctrl->>ApptEntity: checkConflict(doctorId, slotTime)
    activate ApptEntity
    ApptEntity-->>Ctrl: isBooked
    deactivate ApptEntity
    alt Slot Conflict Exists
        Ctrl-->>UI: return Error("Slot already booked")
        UI-->>Patient: displaySlotConflictMsg()
    else Slot Available
        Ctrl->>ApptEntity: create(patientId, doctorId, slotTime, status="Confirmed")
        activate ApptEntity
        ApptEntity-->>Ctrl: apptInstance
        deactivate ApptEntity
        Ctrl->>ApptEntity: save()
        activate ApptEntity
        ApptEntity-->>Ctrl: savedAppt
        deactivate ApptEntity
        Ctrl-->>UI: return BookingConfirmation(apptId)
        UI-->>Patient: renderConfirmationTicket()
    end
    deactivate Ctrl
    deactivate UI
