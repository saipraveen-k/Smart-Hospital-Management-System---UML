sequenceDiagram
    autonumber
    actor Receptionist as Receptionist
    participant UI as AdmissionUI
    participant Ctrl as AdmissionController
    participant WardEntity as Ward
    participant AdmEntity as Admission
    participant BedEntity as Bed

    Receptionist->>UI: selectWardAndGetAvailableBeds(wardId)
    activate UI
    UI->>Ctrl: getAvailableBeds(wardId)
    activate Ctrl
    Ctrl->>WardEntity: findAvailableBeds(wardId)
    activate WardEntity
    WardEntity-->>Ctrl: availableBedList
    deactivate WardEntity
    Ctrl-->>UI: renderBedGrid(availableBedList)
    deactivate Ctrl

    Receptionist->>UI: assignBedToPatient(admissionId, bedId)
    UI->>Ctrl: processBedAllocation(admissionId, bedId)
    activate Ctrl
    Ctrl->>BedEntity: updateStatus(bedId, "Occupied")
    activate BedEntity
    BedEntity-->>Ctrl: bedStatusUpdated
    deactivate BedEntity
    Ctrl->>AdmEntity: updateAdmission(admissionId, bedId, status="BedAllocated")
    activate AdmEntity
    AdmEntity-->>Ctrl: admissionUpdated
    deactivate AdmEntity
    Ctrl-->>UI: return AllocationSuccess()
    UI-->>Receptionist: displayAdmissionCard(admissionId, bedId)
    deactivate Ctrl
    deactivate UI
