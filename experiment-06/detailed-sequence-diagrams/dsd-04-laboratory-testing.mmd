sequenceDiagram
    autonumber
    actor Tech as Lab Technician
    participant UI as LaboratoryUI
    participant Ctrl as LaboratoryController
    participant OrderEntity as LabTestOrder
    participant SampleEntity as Sample
    participant ReportEntity as LabReport

    Tech->>UI: scanSampleBarcode(barcode)
    activate UI
    UI->>Ctrl: getOrderDetailsByBarcode(barcode)
    activate Ctrl
    Ctrl->>OrderEntity: findByBarcode(barcode)
    activate OrderEntity
    OrderEntity-->>Ctrl: orderObj
    deactivate OrderEntity
    Ctrl-->>UI: displayTestParameters(orderObj)
    deactivate Ctrl

    Tech->>UI: submitTestResults(orderId, measuredValues, pdfReport)
    UI->>Ctrl: processResults(orderId, measuredValues, pdfReport)
    activate Ctrl
    Ctrl->>SampleEntity: markProcessed()
    activate SampleEntity
    SampleEntity-->>Ctrl: sampleUpdated
    deactivate SampleEntity
    Ctrl->>ReportEntity: createReport(orderId, measuredValues, status="Approved")
    activate ReportEntity
    ReportEntity-->>Ctrl: reportObj
    deactivate ReportEntity
    Ctrl->>OrderEntity: updateOrderStatus(orderId, "Approved")
    activate OrderEntity
    OrderEntity-->>Ctrl: orderUpdated
    deactivate OrderEntity
    Ctrl-->>UI: return ReportPublishedSuccess(reportId)
    UI-->>Tech: displayApprovalReceipt()
    deactivate Ctrl
    deactivate UI
