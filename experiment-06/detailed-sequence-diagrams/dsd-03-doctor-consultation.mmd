sequenceDiagram
    autonumber
    actor Doctor as Doctor
    participant UI as ConsultationUI
    participant Ctrl as ConsultationController
    participant MedRecEntity as MedicalRecord
    participant ConsultEntity as Consultation
    participant RxEntity as Prescription
    participant LabOrderEntity as LabTestOrder

    Doctor->>UI: selectPatientFromQueue(patientId)
    activate UI
    UI->>Ctrl: getMedicalHistory(patientId)
    activate Ctrl
    Ctrl->>MedRecEntity: findByPatientId(patientId)
    activate MedRecEntity
    MedRecEntity-->>Ctrl: medicalRecordObj
    deactivate MedRecEntity
    Ctrl-->>UI: renderEHRSummary(medicalRecordObj)
    deactivate Ctrl

    Doctor->>UI: submitConsultationNotes(complaints, diagnosisCode, rxList, labList)
    UI->>Ctrl: saveConsultation(patientId, doctorId, notesDto)
    activate Ctrl
    Ctrl->>ConsultEntity: createConsultation(notesDto)
    activate ConsultEntity
    ConsultEntity-->>Ctrl: consultObj
    deactivate ConsultEntity

    opt Prescription Included
        Ctrl->>RxEntity: createPrescription(rxList)
        activate RxEntity
        RxEntity-->>Ctrl: rxObj
        deactivate RxEntity
    end

    opt Lab Tests Ordered
        Ctrl->>LabOrderEntity: createLabOrder(labList)
        activate LabOrderEntity
        LabOrderEntity-->>Ctrl: labOrderObj
        deactivate LabOrderEntity
    end

    Ctrl->>MedRecEntity: appendConsultation(consultObj)
    activate MedRecEntity
    MedRecEntity-->>Ctrl: updatedRecord
    deactivate MedRecEntity

    Ctrl-->>UI: return ConsultationSuccess(consultationId)
    UI-->>Doctor: displaySuccessNotification()
    deactivate Ctrl
    deactivate UI
