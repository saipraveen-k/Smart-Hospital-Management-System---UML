sequenceDiagram
    autonumber
    actor Receptionist as Receptionist
    participant UI as PatientRegistrationUI
    participant Ctrl as PatientRegistrationController
    participant Entity as Patient

    Receptionist->>UI: submitForm(patientDto)
    activate UI
    UI->>Ctrl: registerPatient(patientDto)
    activate Ctrl
    Ctrl->>Ctrl: validateFields(patientDto)
    alt Validation Failed
        Ctrl-->>UI: return ValidationError("Invalid Phone/Email")
        UI-->>Receptionist: displayFieldErrorMsg()
    else Validation Passed
        Ctrl->>Ctrl: checkDuplicatePatient(patientDto.phone)
        alt Duplicate Patient Found
            Ctrl-->>UI: return Error("Patient already exists")
            UI-->>Receptionist: displayDuplicateAlert()
        else Unique Patient
            Ctrl->>Ctrl: generateUHID()
            Ctrl->>Entity: create(patientDto, UHID)
            activate Entity
            Entity-->>Ctrl: patientObj
            deactivate Entity
            Ctrl->>Entity: save()
            activate Entity
            Entity-->>Ctrl: savedPatient
            deactivate Entity
            Ctrl-->>UI: return Success(UHID)
            UI-->>Receptionist: displayRegistrationConfirmation(UHID)
        end
    end
    deactivate Ctrl
    deactivate UI
