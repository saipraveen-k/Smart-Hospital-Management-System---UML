sequenceDiagram
    autonumber
    actor Pharmacist as Pharmacist
    participant UI as PharmacyUI
    participant Ctrl as PharmacyController
    participant RxEntity as Prescription
    participant InvEntity as InventoryItem
    participant BillEntity as Bill

    Pharmacist->>UI: scanPrescription(rxId)
    activate UI
    UI->>Ctrl: verifyPrescription(rxId)
    activate Ctrl
    Ctrl->>RxEntity: findById(rxId)
    activate RxEntity
    RxEntity-->>Ctrl: rxObj
    deactivate RxEntity
    Ctrl-->>UI: displayRxItems(rxObj.items)
    deactivate Ctrl

    Pharmacist->>UI: confirmDispensing(rxId)
    UI->>Ctrl: processDispense(rxId)
    activate Ctrl
    loop For Each Item in Rx
        Ctrl->>InvEntity: checkAndDecrementStock(item.medicineId, item.quantity)
        activate InvEntity
        InvEntity-->>Ctrl: stockUpdated(remainingQty)
        deactivate InvEntity
        opt Low Stock Triggered
            Ctrl->>Ctrl: dispatchLowStockAlert(medicineId)
        end
    end
    Ctrl->>RxEntity: updateStatus(rxId, "Dispensed")
    activate RxEntity
    RxEntity-->>Ctrl: rxUpdated
    deactivate RxEntity
    Ctrl->>BillEntity: postPharmacyCharges(rxObj.patientId, rxObj.totalCost)
    activate BillEntity
    BillEntity-->>Ctrl: chargePosted
    deactivate BillEntity
    Ctrl-->>UI: return DispenseSuccess()
    UI-->>Pharmacist: printDispenseSlip()
    deactivate Ctrl
    deactivate UI
